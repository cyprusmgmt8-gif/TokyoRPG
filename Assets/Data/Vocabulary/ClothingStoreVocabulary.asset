%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1a7c5b38d6e4f02bf4a5b6c7d8e9f01, type: 3}
  m_Name: ClothingStoreVocabulary
  m_EditorClassIdentifier: 
  entries:
  - id: clothing.fuku
    japanese: "服"
    reading: "ふく"
    romaji: fuku
    exampleSentence: "この服、かわいいですね。"
    exampleReading: "このふく、かわいいですね。"
    exampleRomaji: Kono fuku, kawaii desu ne.
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: clothing-store
    objectId: clothes-display
    translations:
    - languageCode: en
      translation: "Clothes"
      exampleTranslation: "These clothes are cute, aren't they?"
      grammarExplanation: "この means \"this\". ね invites the listener to agree."
  - id: clothing.shatsu
    japanese: "シャツ"
    reading: "シャツ"
    romaji: shatsu
    exampleSentence: "このシャツはありますか。"
    exampleReading: "このシャツはありますか。"
    exampleRomaji: Kono shatsu wa arimasu ka.
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: clothing-store
    objectId: shirt-display
    translations:
    - languageCode: en
      translation: "Shirt"
      exampleTranslation: "Do you have this shirt?"
      grammarExplanation: "は marks the topic and is pronounced wa. か turns the sentence into a question."
  - id: clothing.zubon
    japanese: "ズボン"
    reading: "ズボン"
    romaji: zubon
    exampleSentence: "このズボンを試着してもいいですか。"
    exampleReading: "このズボンをしちゃくしてもいいですか。"
    exampleRomaji: Kono zubon o shichaku shite mo ii desu ka.
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: clothing-store
    objectId: pants-rack
    translations:
    - languageCode: en
      translation: "Pants / Trousers"
      exampleTranslation: "May I try these pants on?"
      grammarExplanation: "を marks the pants and is pronounced o. てもいいですか asks for permission."
  - id: clothing.saizu
    japanese: "サイズ"
    reading: "サイズ"
    romaji: saizu
    exampleSentence: "Mサイズはありますか。"
    exampleReading: "エムサイズはありますか。"
    exampleRomaji: Emu saizu wa arimasu ka.
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: clothing-store
    objectId: size-label
    translations:
    - languageCode: en
      translation: "Size"
      exampleTranslation: "Do you have a medium?"
      grammarExplanation: "は marks the topic and is pronounced wa. か turns the sentence into a question."
  - id: clothing.nedan
    japanese: "値段"
    reading: "ねだん"
    romaji: nedan
    exampleSentence: "値段はいくらですか。"
    exampleReading: "ねだんはいくらですか。"
    exampleRomaji: Nedan wa ikura desu ka.
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: clothing-store
    objectId: price-tag
    translations:
    - languageCode: en
      translation: "Price"
      exampleTranslation: "How much is it?"
      grammarExplanation: "は marks the topic and is pronounced wa. いくら means how much."
  - id: clothing.shichakushitsu
    japanese: "試着室"
    reading: "しちゃくしつ"
    romaji: shichakushitsu
    exampleSentence: "試着室はどこですか。"
    exampleReading: "しちゃくしつはどこですか。"
    exampleRomaji: Shichakushitsu wa doko desu ka.
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: clothing-store
    objectId: fitting-room
    translations:
    - languageCode: en
      translation: "Fitting room"
      exampleTranslation: "Where is the fitting room?"
      grammarExplanation: "は marks the topic and is pronounced wa. どこ means where."
  - id: clothing.kagami
    japanese: "鏡"
    reading: "かがみ"
    romaji: kagami
    exampleSentence: "鏡を見てもいいですか。"
    exampleReading: "かがみをみてもいいですか。"
    exampleRomaji: Kagami o mite mo ii desu ka.
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: clothing-store
    objectId: mirror
    translations:
    - languageCode: en
      translation: "Mirror"
      exampleTranslation: "May I look in the mirror?"
      grammarExplanation: "を marks the mirror and is pronounced o. てもいいですか asks for permission."
