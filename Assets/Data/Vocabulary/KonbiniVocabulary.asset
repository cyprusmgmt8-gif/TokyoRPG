  entries:
  - id: konbini.green-tea
    japanese: "お茶"
    reading: "おちゃ"
    romaji: "ocha"
    exampleSentence: "お茶をください。"
    exampleReading: "おちゃをください。"
    exampleRomaji: "Ocha o kudasai."
    audioReference: konbini_green_tea
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: konbini
    objectId: green-tea
    translations:
    - languageCode: en
      translation: "Green tea"
      exampleTranslation: "Green tea, please."
      grammarExplanation: "を marks what you are asking for and is pronounced o. ください means \"please give me\"."
  - id: konbini.water
    japanese: "水"
    reading: "みず"
    romaji: "mizu"
    exampleSentence: "水をください。"
    exampleReading: "みずをください。"
    exampleRomaji: "Mizu o kudasai."
    audioReference: konbini_water
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: konbini
    objectId: water
    translations:
    - languageCode: en
      translation: "water"
      exampleTranslation: "Water, please."
      grammarExplanation: "を marks what you are asking for and is pronounced o. ください means \"please give me\"."
  - id: konbini.coffee
    japanese: "コーヒー"
    reading: "コーヒー"
    romaji: "koohii"
    exampleSentence: "熱いコーヒーをください。"
    exampleReading: "あついコーヒーをください。"
    exampleRomaji: "Atsui koohii o kudasai."
    audioReference: konbini_coffee
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: konbini
    objectId: coffee
    translations:
    - languageCode: en
      translation: "coffee"
      exampleTranslation: "A hot coffee, please."
      grammarExplanation: "熱い means hot. を marks the coffee and is pronounced o."
  - id: konbini.onigiri
    japanese: "おにぎり"
    reading: "おにぎり"
    romaji: "onigiri"
    exampleSentence: "おにぎりを二つください。"
    exampleReading: "おにぎりをふたつください。"
    exampleRomaji: "Onigiri o futatsu kudasai."
