    roomId: konbini
    objectId: sandwich
    translations:
    - languageCode: en
      translation: "sandwich"
      exampleTranslation: "This sandwich, please."
      grammarExplanation: "この means \"this\". を marks the sandwich and is pronounced o."
  - id: konbini.register
    japanese: "レジ"
    reading: "レジ"
    romaji: "reji"
    exampleSentence: "レジはどこですか。"
