  entries:
  - id: bedroom.bed
    japanese: "ベッド"
    reading: "ベッド"
    exampleSentence: "これはベッドです。"
    exampleReading: "これはベッドです。"
    audioReference: bedroom_bed
    wordClip: {fileID: 8300000, guid: 784bc2e94e294eab85ff8b0f023f0fff, type: 3}
    exampleClip: {fileID: 8300000, guid: 7f88e1ba73314892b0ac68a0016d0cfe, type: 3}
    roomId: bedroom
    objectId: bed
    translations:
    - languageCode: en
      translation: "bed"
      exampleTranslation: "This is a bed."
      grammarExplanation: "これは means \"this is\". です is the polite ending."
  - id: bedroom.desk
    japanese: "机"
    reading: "つくえ"
    exampleSentence: "机で勉強します。"
    exampleReading: "つくえでべんきょうします。"
    audioReference: bedroom_desk
