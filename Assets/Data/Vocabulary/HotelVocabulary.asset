%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1a7c5b38d6e4f02bf4a5b6c7d8e9f01, type: 3}
  m_Name: HotelVocabulary
  m_EditorClassIdentifier: 
  entries:
  - id: hotel.yoyaku
    japanese: "予約"
    reading: "よやく"
    romaji: yoyaku
    exampleSentence: "予約しています。"
    exampleReading: "よやくしています。"
    exampleRomaji: Yoyaku shite imasu.
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: hotel
    objectId: reservation
    translations:
    - languageCode: en
      translation: "Reservation"
      exampleTranslation: "I have a reservation."
      grammarExplanation: "しています means the reservation is already in place."
  - id: hotel.uketsuke
    japanese: "受付"
    reading: "うけつけ"
    romaji: uketsuke
    exampleSentence: "受付はどこですか？"
    exampleReading: "うけつけはどこですか？"
    exampleRomaji: Uketsuke wa doko desu ka?
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: hotel
    objectId: reception
    translations:
    - languageCode: en
      translation: "Reception / Front desk"
      exampleTranslation: "Where is reception?"
      grammarExplanation: "は marks the topic and is pronounced wa. か turns the sentence into a question."
  - id: hotel.heya
    japanese: "部屋"
    reading: "へや"
    romaji: heya
    exampleSentence: "部屋は何階ですか？"
    exampleReading: "へやはなんかいですか？"
    exampleRomaji: Heya wa nankai desu ka?
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: hotel
    objectId: room-sign
    translations:
    - languageCode: en
      translation: "Room"
      exampleTranslation: "Which floor is my room on?"
      grammarExplanation: "は marks the topic and is pronounced wa. 何階 means which floor."
  - id: hotel.kagi
    japanese: "鍵"
    reading: "かぎ"
    romaji: kagi
    exampleSentence: "鍵をなくしました。"
    exampleReading: "かぎをなくしました。"
    exampleRomaji: Kagi o nakushimashita.
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: hotel
    objectId: key-card
    translations:
    - languageCode: en
      translation: "Key"
      exampleTranslation: "I've lost my key."
      grammarExplanation: "を marks the key and is pronounced o. なくしました means lost."
  - id: hotel.nimotsu
    japanese: "荷物"
    reading: "にもつ"
    romaji: nimotsu
    exampleSentence: "荷物を預けてもいいですか？"
    exampleReading: "にもつをあずけてもいいですか？"
    exampleRomaji: Nimotsu o azukete mo ii desu ka?
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: hotel
    objectId: luggage
    translations:
    - languageCode: en
      translation: "Luggage / Belongings"
      exampleTranslation: "Could you hold my luggage?"
      grammarExplanation: "を marks the luggage and is pronounced o. てもいいですか asks for permission."
  - id: hotel.erebeetaa
    japanese: "エレベーター"
    reading: "エレベーター"
    romaji: erebeetaa
    exampleSentence: "エレベーターはどこですか？"
    exampleReading: "エレベーターはどこですか？"
    exampleRomaji: Erebeetaa wa doko desu ka?
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: hotel
    objectId: elevator
    translations:
    - languageCode: en
      translation: "Elevator / Lift"
      exampleTranslation: "Where is the elevator?"
      grammarExplanation: "は marks the topic and is pronounced wa. どこ means where."
  - id: hotel.choushoku
    japanese: "朝食"
    reading: "ちょうしょく"
    romaji: choushoku
    exampleSentence: "朝食は何時からですか？"
    exampleReading: "ちょうしょくはなんじからですか？"
    exampleRomaji: Choushoku wa nanji kara desu ka?
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: hotel
    objectId: breakfast
    translations:
    - languageCode: en
      translation: "Breakfast"
      exampleTranslation: "What time does breakfast start?"
      grammarExplanation: "は marks the topic and is pronounced wa. 何時 means what time."
  - id: hotel.pasupooto
    japanese: "パスポート"
    reading: "パスポート"
    romaji: pasupooto
    exampleSentence: "パスポートを見せてください。"
    exampleReading: "パスポートをみせてください。"
    exampleRomaji: Pasupooto o misete kudasai.
    audioReference: 
    wordClip: {fileID: 0}
    exampleClip: {fileID: 0}
    roomId: hotel
    objectId: passport
    translations:
    - languageCode: en
      translation: "Passport"
      exampleTranslation: "Please show me your passport."
      grammarExplanation: "This is what the staff asks the guest. を marks the passport and is pronounced o."
