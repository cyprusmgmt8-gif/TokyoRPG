        reading: "こんにちは。"
        romaji: Konnichiwa.
        english: Hello.
      action: next
      nextLineId: hello
    - phrase:
        id: phrase.arigatou
        japanese: "ありがとうございます。"
        reading: "ありがとうございます。"
        romaji: Arigatou gozaimasu.
        english: Thank you.
      action: next
      nextLineId: thanks
    - phrase:
        id: phrase.okaikei
        japanese: "お会計をお願いします。"
        reading: "おかいけいをおねがいします。"
        romaji: Okaikei o onegai shimasu.
        english: The bill, please.
      action: checkout
      nextLineId: 
