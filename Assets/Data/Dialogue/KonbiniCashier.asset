      japanese: "またお越しください。"
      reading: "またおこしください。"
      romaji: Mata okoshi kudasai.
      english: Please come again.
    choices:
    - phrase:
        id: phrase.sayounara
        japanese: "さようなら。"
        reading: "さようなら。"
        romaji: Sayounara.
        english: Goodbye.
      action: end
      nextLineId: 
  - id: bill
    phrase:
      id: phrase.irasshaimase
      japanese: "いらっしゃいませ。"
      reading: "いらっしゃいませ。"
      romaji: Irasshaimase.
      english: Welcome.
    choices:
    - phrase:
        id: phrase.okaikei
        japanese: "お会計をお願いします。"
        reading: "おかいけいをおねがいします。"
        romaji: Okaikei o onegai shimasu.
        english: The bill, please.
      action: checkout
      nextLineId: 
  - id: bag
    phrase:
      id: phrase.fukuro-goriyou
      japanese: "袋はご利用ですか？"
      reading: "ふくろはごりようですか？"
      romaji: Fukuro wa goriyou desu ka?
