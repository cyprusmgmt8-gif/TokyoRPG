%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4c8e2f19b304d6e8f7a1c2d3e4f5061, type: 3}
  m_Name: KonbiniCashier
  m_EditorClassIdentifier: 
  npcId: konbini.cashier
  speakerJapanese: "店員"
  speakerReading: "てんいん"
  speakerRomaji: tenin
  speakerEnglish: Cashier
  startLineId: welcome
  lines:
  - id: welcome
    phrase:
      id: phrase.irasshaimase
      japanese: "いらっしゃいませ。"
      reading: "いらっしゃいませ。"
      romaji: Irasshaimase.
      english: Welcome!
    choices:
    - phrase:
        id: phrase.chotto-miteru
        japanese: "ちょっと見てるだけです。"
        reading: "ちょっとみてるだけです。"
        romaji: Chotto miteru dake desu.
        english: I'm just looking, thanks.
      action: next
      nextLineId: looking
    - phrase:
        id: phrase.okaikei
        japanese: "お会計をお願いします。"
        reading: "おかいけいをおねがいします。"
        romaji: Okaikei o onegai shimasu.
        english: The bill, please.
      action: checkout
      nextLineId: 
  - id: looking
    phrase:
      id: phrase.goyukkuri
      japanese: "どうぞごゆっくり。"
      reading: "どうぞごゆっくり。"
      romaji: Douzo goyukkuri.
      english: Please take your time.
    choices: []
  - id: bill
    phrase:
      id: phrase.irasshaimase
      japanese: "いらっしゃいませ。"
      reading: "いらっしゃいませ。"
      romaji: Irasshaimase.
      english: Welcome.
    choices:
    - phrase:
        id: phrase.okaikei
        japanese: "お会計をお願いします。"
        reading: "おかいけいをおねがいします。"
        romaji: Okaikei o onegai shimasu.
        english: The bill, please.
      action: checkout
      nextLineId: 
  - id: bag
    phrase:
      id: phrase.fukuro-goriyou
      japanese: "袋はご利用ですか？"
      reading: "ふくろはごりようですか？"
      romaji: Fukuro wa goriyou desu ka?
      english: Would you like a bag?
    choices:
    - phrase:
        id: phrase.hai-onegai
        japanese: "はい、お願いします。"
        reading: "はい、おねがいします。"
        romaji: Hai, onegai shimasu.
        english: Yes, please.
      action: next
      nextLineId: payment
    - phrase:
        id: phrase.iie-daijoubu
        japanese: "いいえ、大丈夫です。"
        reading: "いいえ、だいじょうぶです。"
        romaji: Iie, daijoubu desu.
        english: No, that's okay.
      action: next
      nextLineId: payment
  - id: payment
    phrase:
      id: phrase.oshiharai
      japanese: "お支払い方法は？"
      reading: "おしはらいほうほうは？"
      romaji: Oshiharai houhou wa?
      english: How would you like to pay?
    choices:
    - phrase:
        id: phrase.genkin
        japanese: "現金でお願いします。"
        reading: "げんきんでおねがいします。"
        romaji: Genkin de onegai shimasu.
        english: Cash, please.
      action: summary
      nextLineId: 
    - phrase:
        id: phrase.kaado
        japanese: "カードでお願いします。"
        reading: "カードでおねがいします。"
        romaji: Kaado de onegai shimasu.
        english: Card, please.
      action: summary
      nextLineId: 
  - id: empty-basket
    phrase:
      id: phrase.empty-basket
      japanese: "すみません。まだ何もありません。"
      reading: "すみません。まだなにもありません。"
      romaji: Sumimasen. Mada nanimo arimasen.
      english: Sorry. There isn't anything to buy yet.
    choices:
    - phrase:
        id: phrase.wakarimashita
        japanese: "わかりました。"
        reading: "わかりました。"
        romaji: Wakarimashita.
        english: I understand.
      action: next
      nextLineId: welcome
  - id: purchase-thanks
    phrase:
      id: phrase.arigatou-gozaimashita-mata
      japanese: "ありがとうございました。またお越しください。"
      reading: "ありがとうございました。またおこしください。"
      romaji: Arigatou gozaimashita. Mata okoshi kudasai.
      english: Thank you very much. Please visit again.
    choices: []
