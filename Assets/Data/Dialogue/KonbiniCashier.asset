    phrase:
      id: phrase.nanika-osagashi
      japanese: "こんにちは。何かお探しですか。"
      reading: "こんにちは。なにかおさがしですか。"
      romaji: Konnichiwa. Nanika osagashi desu ka.
      english: Hello. Are you looking for something?
    choices:
    - phrase:
        id: phrase.chotto-miteru
        japanese: "ちょっと見てるだけです。"
        reading: "ちょっとみてるだけです。"
        romaji: Chotto miteru dake desu.
        english: I'm just looking.
      action: next
      nextLineId: looking
    - phrase:
        id: phrase.okaikei
        japanese: "お会計をお願いします。"
        reading: "おかいけいをおねがいします。"
        romaji: Okaikei o onegai shimasu.
        english: The bill, please.
      action: checkout
      nextLineId: 
  - id: thanks
    phrase:
      id: phrase.douitashimashite
      japanese: "どういたしまして。"
      reading: "どういたしまして。"
      romaji: Dou itashimashite.
      english: You're welcome.
    choices:
    - phrase:
        id: phrase.okaikei
        japanese: "お会計をお願いします。"
        reading: "おかいけいをおねがいします。"
        romaji: Okaikei o onegai shimasu.
        english: The bill, please.
      action: checkout
      nextLineId: 
    - phrase:
        id: phrase.sayounara
