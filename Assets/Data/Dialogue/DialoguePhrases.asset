%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9a1c4b72d8f4e0a9c3b5d7f1a2e4c60, type: 3}
  m_Name: DialoguePhrases
  m_EditorClassIdentifier: 
  phrases:
  - id: phrase.irasshaimase
    japanese: "いらっしゃいませ。"
    reading: "いらっしゃいませ。"
    romaji: Irasshaimase.
    english: Welcome.
  - id: phrase.konnichiwa
    japanese: "こんにちは。"
    reading: "こんにちは。"
    romaji: Konnichiwa.
    english: Hello.
  - id: phrase.arigatou
    japanese: "ありがとうございます。"
    reading: "ありがとうございます。"
    romaji: Arigatou gozaimasu.
    english: Thank you.
  - id: phrase.okaikei
    japanese: "お会計をお願いします。"
    reading: "おかいけいをおねがいします。"
    romaji: Okaikei o onegai shimasu.
    english: The bill, please.
  - id: phrase.nanika-osagashi
    japanese: "こんにちは。何かお探しですか。"
    reading: "こんにちは。なにかおさがしですか。"
    romaji: Konnichiwa. Nanika osagashi desu ka.
    english: Hello. Are you looking for something?
  - id: phrase.chotto-miteru
    japanese: "ちょっと見てるだけです。"
    reading: "ちょっとみてるだけです。"
    romaji: Chotto miteru dake desu.
    english: I'm just looking, thanks.
  - id: phrase.douitashimashite
    japanese: "どういたしまして。"
    reading: "どういたしまして。"
    romaji: Dou itashimashite.
    english: You're welcome.
  - id: phrase.sayounara
    japanese: "さようなら。"
    reading: "さようなら。"
    romaji: Sayounara.
    english: Goodbye.
  - id: phrase.yukkuri-douzo
    japanese: "ゆっくりどうぞ。"
    reading: "ゆっくりどうぞ。"
    romaji: Yukkuri douzo.
    english: Take your time.
  - id: phrase.arigatou-gozaimashita
    japanese: "ありがとうございました。"
    reading: "ありがとうございました。"
    romaji: Arigatou gozaimashita.
    english: Thank you.
  - id: phrase.mata-okoshi
    japanese: "またお越しください。"
    reading: "またおこしください。"
    romaji: Mata okoshi kudasai.
    english: Please come again.
  - id: phrase.fukuro-goriyou
    japanese: "袋はご利用ですか？"
    reading: "ふくろはごりようですか？"
    romaji: Fukuro wa goriyou desu ka?
    english: Would you like a bag?
  - id: phrase.hai-onegai
    japanese: "はい、お願いします。"
    reading: "はい、おねがいします。"
    romaji: Hai, onegai shimasu.
    english: Yes, please.
  - id: phrase.iie-daijoubu
    japanese: "いいえ、大丈夫です。"
    reading: "いいえ、だいじょうぶです。"
    romaji: Iie, daijoubu desu.
    english: No, that's okay.
  - id: phrase.oshiharai
    japanese: "お支払い方法は？"
    reading: "おしはらいほうほうは？"
    romaji: Oshiharai houhou wa?
    english: How would you like to pay?
  - id: phrase.genkin
    japanese: "現金でお願いします。"
    reading: "げんきんでおねがいします。"
    romaji: Genkin de onegai shimasu.
    english: Cash, please.
  - id: phrase.kaado
    japanese: "カードでお願いします。"
    reading: "カードでおねがいします。"
    romaji: Kaado de onegai shimasu.
    english: Card, please.
  - id: phrase.arigatou-mata
    japanese: "ありがとうございます。またお越しください。"
    reading: "ありがとうございます。またおこしください。"
    romaji: Arigatou gozaimasu. Mata okoshi kudasai.
    english: Thank you very much. Please come again.
  - id: phrase.empty-basket
    japanese: "すみません。まだ何もありません。"
    reading: "すみません。まだなにもありません。"
    romaji: Sumimasen. Mada nanimo arimasen.
    english: Sorry. There isn't anything to buy yet.
  - id: phrase.wakarimashita
    japanese: "わかりました。"
    reading: "わかりました。"
    romaji: Wakarimashita.
    english: I understand.
  - id: phrase.koe-o-kakete
    japanese: "こんにちは。何かありましたら、声をかけてください。"
    reading: "こんにちは。なにかありましたら、こえをかけてください。"
    romaji: Konnichiwa. Nanika arimashitara, koe o kakete kudasai.
    english: Hello. If you need anything, please let me know.
  - id: phrase.chotto-mitekimasu
    japanese: "ありがとうございます。ちょっと見てきます。"
    reading: "ありがとうございます。ちょっとみてきます。"
    romaji: Arigatou gozaimasu. Chotto mitekimasu.
    english: Thank you. I'll have a look around.
  - id: phrase.douzo-goyukkuri
    japanese: "はい、どうぞごゆっくり。"
    reading: "はい、どうぞごゆっくり。"
    romaji: Hai, douzo goyukkuri.
    english: Yes, please take your time.
  - id: phrase.dochira-osagashi
    japanese: "はい。どちらをお探しですか。"
    reading: "はい。どちらをおさがしですか。"
    romaji: Hai. Dochira o osagashi desu ka.
    english: Yes. What are you looking for?
  - id: phrase.tenimotsu-doko
    japanese: "手荷物受取所はどこですか。"
    reading: "てにもつうけとりじょはどこですか。"
    romaji: Tenimotsu uketorijo wa doko desu ka.
    english: Where is baggage claim?
  - id: phrase.massugu-hidarite
    japanese: "まっすぐ行って、左手です。"
    reading: "まっすぐいって、ひだりてです。"
    romaji: Massugu itte, hidarite desu.
    english: Go straight, and it is on the left.
  - id: phrase.nanika-okomari
    japanese: "何かお困りですか。"
    reading: "なにかおこまりですか。"
    romaji: Nanika okomari desu ka.
    english: Is there anything I can help you with?
  - id: phrase.homu-doko
    japanese: "ホームはどこですか。"
    reading: "ホームはどこですか。"
    romaji: Hoomu wa doko desu ka.
    english: Where is the platform?
  - id: phrase.kaisatsu-massugu
    japanese: "改札を通って、まっすぐ進んでください。"
    reading: "かいさつをとおってまっすぐすすんでください。"
    romaji: Kaisatsu o tootte, massugu susunde kudasai.
    english: Go through the ticket gates and continue straight ahead.
  - id: phrase.goyukkuri
    japanese: "どうぞごゆっくり。"
    reading: "どうぞごゆっくり。"
    romaji: Douzo goyukkuri.
    english: Please take your time.
  - id: phrase.arigatou-gozaimashita-mata
    japanese: "ありがとうございました。またお越しください。"
    reading: "ありがとうございました。またおこしください。"
    romaji: Arigatou gozaimashita. Mata okoshi kudasai.
    english: Thank you very much. Please visit again.
  - id: phrase.atatamemasu-ka
    japanese: "温めますか？"
    reading: "あたためますか？"
    romaji: Atatamemasu ka?
    english: Would you like me to heat it up?
  - id: phrase.ramen-hitotsu
    japanese: "ラーメンを一つお願いします。"
    reading: "ラーメンをひとつおねがいします。"
    romaji: Raamen o hitotsu onegai shimasu.
    english: One ramen, please.
  - id: phrase.omizu-kudasai
    japanese: "お水をください。"
    reading: "おみずをください。"
    romaji: Omizu o kudasai.
    english: Water, please.
  - id: phrase.menyuu-miteimasu
    japanese: "ちょっとメニューを見てもいいですか？"
    reading: "ちょっとメニューをみてもいいですか？"
    romaji: Chotto menyuu o mite mo ii desu ka?
    english: Can I take a look at the menu?
  - id: phrase.kashikomarimashita-toppingu
    japanese: "かしこまりました。トッピングはどうしますか？"
    reading: "かしこまりました。トッピングはどうしますか？"
    romaji: Kashikomarimashita. Toppingu wa dou shimasu ka.
    english: Certainly. Would you like any toppings?
  - id: phrase.chaashuu-onegai
    japanese: "チャーシューをお願いします。"
    reading: "チャーシューをおねがいします。"
    romaji: Chaashuu o onegai shimasu.
    english: Chashu, please.
  - id: phrase.sono-mama
    japanese: "そのままでお願いします。"
    reading: "そのままでおねがいします。"
    romaji: Sono mama de onegai shimasu.
    english: Just as it is, please.
  - id: phrase.chaashuu-iri-omachi
    japanese: "チャーシュー入りですね。少々お待ちください。"
    reading: "チャーシューいりですね。しょうしょうおまちください。"
    romaji: Chaashuu-iri desu ne. Shoushou omachi kudasai.
    english: Chashu it is. One moment, please.
  - id: phrase.sono-mama-omachi
    japanese: "はい、そのままで。少々お待ちください。"
    reading: "はい、そのままで。しょうしょうおまちください。"
    romaji: Hai, sono mama de. Shoushou omachi kudasai.
    english: Yes, just as it is. One moment, please.
  - id: phrase.hai-douzo
    japanese: "はい、どうぞ。"
    reading: "はい、どうぞ。"
    romaji: Hai, douzo.
    english: Here you go.
  - id: phrase.emu-saizu-arimasu
    japanese: "これのMサイズはありますか？"
    reading: "これのエムサイズはありますか？"
    romaji: Kore no emu saizu wa arimasu ka?
    english: Do you have this in medium?
  - id: phrase.hai-gozaimasu-shoushou
    japanese: "はい、ございます。少々お待ちください。"
    reading: "はい、ございます。しょうしょうおまちください。"
    romaji: Hai, gozaimasu. Shoushou omachi kudasai.
    english: Yes, we do. Just a moment, please.
  - id: phrase.kore-shichaku-ii
    japanese: "これ、試着してもいいですか？"
    reading: "これ、しちゃくしてもいいですか？"
    romaji: Kore, shichaku shite mo ii desu ka?
    english: Can I try this on?
  - id: phrase.shichakushitsu-achira
    japanese: "はい、どうぞ。試着室はあちらです。"
    reading: "はい、どうぞ。しちゃくしつはあちらです。"
    romaji: Hai, douzo. Shichakushitsu wa achira desu.
    english: Of course. The fitting room is over there.
  - id: phrase.kore-ikura
    japanese: "これ、いくらですか？"
    reading: "これ、いくらですか？"
    romaji: Kore, ikura desu ka?
    english: How much is this?
  - id: phrase.sanzen-en
    japanese: "こちらは三千円です。"
    reading: "こちらはさんぜんえんです。"
    romaji: Kochira wa sanzen en desu.
    english: This one is 3,000 yen.
  - id: phrase.kashikomarimashita-goran
    japanese: "かしこまりました。ごゆっくりご覧ください。"
    reading: "かしこまりました。ごゆっくりごらんください。"
    romaji: Kashikomarimashita. Goyukkuri goran kudasai.
    english: Certainly. Please take your time.
  - id: phrase.yoyaku-chekkuin
    japanese: "予約しています。チェックインをお願いします。"
    reading: "よやくしています。チェックインをおねがいします。"
    romaji: Yoyaku shite imasu. Chekkuin o onegaishimasu.
    english: I have a reservation. I'd like to check in.
  - id: phrase.kashikomarimashita-onamae
    japanese: "かしこまりました。お名前をお願いします。"
    reading: "かしこまりました。おなまえをおねがいします。"
    romaji: Kashikomarimashita. Onamae o onegaishimasu.
    english: Certainly. May I have your name?
  - id: phrase.maikeru-desu
    japanese: "マイケルです。"
    reading: "マイケルです。"
    romaji: Maikeru desu.
    english: My name is Michael.
  - id: phrase.pasupooto-haiken
    japanese: "ありがとうございます。パスポートを拝見してもよろしいですか？"
    reading: "ありがとうございます。パスポートをはいけんしてもよろしいですか？"
    romaji: Arigatou gozaimasu. Pasupooto o haiken shite mo yoroshii desu ka?
    english: Thank you. May I see your passport?
  - id: phrase.oheya-sankai
    japanese: "ありがとうございます。お部屋は三階です。"
    reading: "ありがとうございます。おへやはさんがいです。"
    romaji: Arigatou gozaimasu. Oheya wa sankai desu.
    english: Thank you. Your room is on the third floor.
  - id: phrase.nimotsu-azukatte
    japanese: "チェックアウト後、荷物を預かってもらえますか？"
    reading: "チェックアウトご、にもつをあずかってもらえますか？"
    romaji: Chekkuauto go, nimotsu o azukatte moraemasu ka?
    english: Could you hold my luggage after checkout?
  - id: phrase.furonto-oazukari
    japanese: "はい、フロントでお預かりできます。"
    reading: "はい、フロントでおあずかりできます。"
    romaji: Hai, furonto de oazukari dekimasu.
    english: Yes, we can hold it at reception.
  - id: phrase.choushoku-nanji
    japanese: "朝食は何時からですか？"
    reading: "ちょうしょくはなんじからですか？"
    romaji: Choushoku wa nanji kara desu ka?
    english: What time does breakfast start?
  - id: phrase.choushoku-shichiji
    japanese: "朝食は朝七時からです。"
    reading: "ちょうしょくはあさしちじからです。"
    romaji: Choushoku wa asa shichiji kara desu.
    english: Breakfast starts at 7 AM.
  - id: phrase.waifai-pasuwaado
    japanese: "Wi-Fiのパスワードを教えてもらえますか？"
    reading: "ワイファイのパスワードをおしえてもらえますか？"
    romaji: Waifai no pasuwaado o oshiete moraemasu ka?
    english: Could you tell me the Wi-Fi password?
  - id: phrase.waifai-heya-annai
    japanese: "Wi-Fiのパスワードはお部屋にご案内があります。"
    reading: "ワイファイのパスワードはおへやにごあんないがあります。"
    romaji: Waifai no pasuwaado wa oheya ni goannai ga arimasu.
    english: The Wi-Fi password information is in your room.
