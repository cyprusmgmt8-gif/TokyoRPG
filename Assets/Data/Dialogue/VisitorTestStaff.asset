MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4c8e2f19b304d6e8f7a1c2d3e4f5061, type: 3}
  m_Name: VisitorTestStaff
  m_EditorClassIdentifier: 
  npcId: visitor-test.staff
  speakerJapanese: "係の人"
  speakerReading: "かかりのひと"
  speakerRomaji: kakari no hito
  speakerEnglish: Staff member
  startLineId: greeting
  lines:
  - id: greeting
    phrase:
      id: phrase.koe-o-kakete
      japanese: "こんにちは。何かありましたら、声をかけてください。"
      reading: "こんにちは。なにかありましたら、こえをかけてください。"
      romaji: Konnichiwa. Nanika arimashitara, koe o kakete kudasai.
      english: Hello. If you need anything, please let me know.
    choices:
    - phrase:
        id: phrase.chotto-mitekimasu
        japanese: "ありがとうございます。ちょっと見てきます。"
        reading: "ありがとうございます。ちょっとみてきます。"
        romaji: Arigatou gozaimasu. Chotto mitekimasu.
        english: Thank you. I'll have a look around.
      action: next
      nextLineId: take-your-time
  - id: take-your-time
    phrase:
      id: phrase.douzo-goyukkuri
      japanese: "はい、どうぞごゆっくり。"
      reading: "はい、どうぞごゆっくり。"
      romaji: Hai, douzo goyukkuri.
      english: Yes, please take your time.
    choices:
    - phrase:
        id: phrase.wakarimashita
        japanese: "わかりました。"
        reading: "わかりました。"
        romaji: Wakarimashita.
        english: I understand.
      action: end
      nextLineId: 
